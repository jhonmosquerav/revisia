# Entornos y caché
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Secretos
.env

# Corridas (`runs/<slug>-<fecha>/`): NO se versionan en el repo del motor (D11
# de la Ola 1; auditoría 2026-09-03, M23). Una corrida pertenece a su revisión,
# no al motor: deposítala completa (manifest.yml, decisions_ledger.jsonl,
# deliverable/…) en OSF/Zenodo o junto al protocolo. Las antiguas negaciones
# `!runs/*/manifest.yml` y `!runs/*/deliverable/` nunca funcionaron (git no
# re-incluye hijos de un directorio ignorado): esto no deja fuera nada que antes
# se versionara.
runs/

# Datos crudos descargados (paywalls, PDFs) nunca al repo
**/fulltext_cache/
**/*.pdf

# Revisiones reales (con tus datos) conviene mantenerlas APARTE del motor,
# en cualquier carpeta tuya, y correrlas pasando su ruta al CLI
# (`prisma-loop run <ruta>`). Solo la plantilla se versiona; cualquier
# protocolo concreto creado por error DENTRO del motor queda fuera de git.
protocols/*/
!protocols/_TEMPLATE/

# Cerebro de investigador (memoria personal acumulada con --brain): es TUYA,
# no del repositorio. Ver docs/memoria-cerebro.md.
cerebro/

# Cobertura local (pytest-cov)
.coverage*
coverage.xml
htmlcov/

# Artefactos de proceso de agentes (planes/borradores locales): no son del repo.
.superpowers/
