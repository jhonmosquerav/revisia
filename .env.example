# prisma-loop · variables de entorno
# Copia este archivo a .env y rellena SOLO las claves del/los proveedor(es)
# que vayas a usar. El núcleo es provider-agnostic: eliges el proveedor por
# etapa en protocol.yml; aquí solo van las credenciales.
#
# NUNCA commitees el archivo .env (está en .gitignore).

# ── Proveedores LLM (elige uno o varios) ────────────────────────────────
# Google Gemini (default del autor · también usado para embeddings)
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic (API directa · NO es Claude Code)
ANTHROPIC_API_KEY=

# Claude Code (suscripción Max/Pro · provider: claude_code · sin API key)
# Token de larga duración para modo headless. Acúñalo UNA vez con:
#     claude setup-token
# y pega el valor aquí. El CLI lo usa para autenticar con tu suscripción.
# Nota: un `claude -p` lanzado DENTRO de otra sesión de Claude Code no hereda la
# auth del host (token gestionado en memoria); este token es lo que lo desbloquea.
CLAUDE_CODE_OAUTH_TOKEN=
# Si tu shell hereda un ANTHROPIC_BASE_URL/USE_STAGING_OAUTH ajeno (entornos de
# desarrollo), pon 1 para que el subproceso `claude` los ignore al usar tu token.
PRISMA_LOOP_CLAUDE_CODE_CLEAN_ENV=

# Endpoint local OpenAI-compatible (Ollama / vLLM / LM Studio)
# Ej: http://localhost:11434/v1  (Ollama)
LOCAL_OPENAI_BASE_URL=
LOCAL_OPENAI_API_KEY=not-needed

# ── Vector store para grounding/RAG (opcional) ──────────────────────────
# Si no se define, el sistema usa un store en-memoria portátil (sin Docker).
# El modelo/dimensión de embeddings se configura en código (ver
# prisma_loop/rag/embed.py); el grounding por defecto no necesita ninguna key.
QDRANT_URL=
QDRANT_API_KEY=
